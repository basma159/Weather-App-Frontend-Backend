<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/all.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Weather App</title>
</head>

<body>
    <div class="container w-fit flex flex-col items-center gap-7 backdrop-blur-2xl 
    ring-1 ring-[#013440] rounded-lg p-8 shadow-xl shadow-black max-h-[350px] overflow-y-auto ">
        <h1 class="text-white text-xl md:text-2xl lg:text-4xl font-bold flex justify-center items-center gap-3">
            <img src={{img1}} class="w-10 h-10" alt="">Weather App</h1>
        <form id="form" class="flex flex-col md:flex-row gap-4">
            <input type="text" id="address" placeholder="Enter Country Name">
            <button class="bg-[#03658C] text-white lg:hover:bg-white lg:hover:text-[#03658C] transition duration-300"
                id="search"><i class="fa-solid fa-magnifying-glass"></i> Get
                Weather</button>
        </form>
        <div class="div1 flex flex-col gap-5">
            <p id="location"></p>
            <p id="lat"></p>
            <p id="lon"></p>
            <p id="forecast"></p>
            <p id="weather"></p>
            <p id="wind"></p>
            <p id="humidity"></p>
            <p id="error" class="text-sm md:text-xl"></p>
        </div>
    </div>
    <script src="/js/script.js"></script>
</body>

</html>